# Copy this file to .env and fill in your own values. Never commit the real .env.
#
# Optional: this project uses Doppler (https://doppler.com) for secret injection.
# If you use Doppler, run `doppler run -- npm run start:dev` and these local
# values are ignored. Otherwise set them directly here.

# PostgreSQL connection string (Prisma / TypeORM)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Solarman (inverter monitoring) API credentials
SOLARMAN_ORG_ID=your_org_id
SOLARMAN_APP_ID=your_app_id
SOLARMAN_APP_SECRET=your_app_secret
SOLARMAN_EMAIL=your_account_email
SOLARMAN_PASSWORD_SHA256=sha256_of_your_password

# Absolute path to the Firebase Admin SDK service-account JSON file (not committed).
FIREBASE_CREDENTIAL_PATH=/path/to/firebase-adminsdk.json

# Redis (used for caching; adjust to your Redis instance)
# REDIS_HOST=localhost
# REDIS_PORT=6379